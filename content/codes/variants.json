  {
   "id": "american",
   "name": "American Morse",
   "script": "Latin",
   "about": "The original code of Morse and Vail, used on North American landline telegraphs and railroads well into the 20th century. It has three lengths of mark and some letters with a longer gap inside them (C, O, R, Y, Z and &), which is why it suited a sounder's clicks better than radio. You'll rarely hear it on air, though a few enthusiasts keep it alive on landline-style circuits.",
   "dir": "ltr",
   "timing": {
    "dot": 1,
    "dash": 2,
    "long": 4,
    "xlong": 6,
    "gap": 1,
    "longGap": 2,
    "letter": 3,
    "word": 6,
    "note": "Sources agree on the order of the lengths, not exact figures; operators varied. This app uses dot 1, dash 2, L 4, zero 6, inner gap 1, the long inner gap 2, letter gap 3, word gap 6."
   },
   "legend": "A space inside a code is the long inner gap; _ is the long dash (L) and = the extra-long dash (0).",
